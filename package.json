{
  "name": "@budaknyenyel/supa-release-gate-mcp",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "description": "Human-approved release gate for Supabase and cloud providers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fridaysundaymood/supa-release-gate-mcp.git"
  },
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    }
  },
  "bin": {
    "release": "./dist/cli/index.js",
    "release-mcp": "./dist/mcp/index.js"
  },
  "files": [
    "dist",
    "skills",
    "AGENTS.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "biome check .",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepare-publish": "node scripts/prepare-publish.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@budaknyenyel/kit-schema": "file:../android-kit/packages/kit-schema",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@types/node": "^24.0.0",
    "node-pty": "^1.1.0",
    "supabase": "2.75.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "supabase@2.75.0": true,
    "node-pty@1.1.0": true
  }
}
